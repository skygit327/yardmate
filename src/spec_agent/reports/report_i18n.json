  "patterns": [
    {
      "en": "^(?P<label>.+): The value is (?P<amount>[0-9.]+) (?P<unit>mm|µm) above the limit\\.$",
      "ko": "{label}: 기준보다 {amount} {unit} 초과입니다.",
      "zh": "{label}：超出标准 {amount} {unit}。"
    },
    {
      "en": "^(?P<label>.+): The value is (?P<amount>[0-9.]+) (?P<unit>mm|µm) below the limit\\.$",
      "ko": "{label}: 기준보다 {amount} {unit} 미달입니다.",
      "zh": "{label}：低于标准 {amount} {unit}。"
    },
    {
      "en": "^(?P<label>.+): The value equals the boundary, but equality is not permitted\\.$",
      "ko": "{label}: 경계값과 같지만 등호가 허용되지 않습니다.",
      "zh": "{label}：等于边界值，但不允许取等号。"
    },
    {
      "en": "^(?P<label>.+): Missing value or unit mismatch$",
      "ko": "{label}: 값 누락 또는 단위 불일치",
      "zh": "{label}：缺少数值或单位不一致"
    },
    {
      "en": "^(?P<label>.+): Not verified$",
      "ko": "{label}: 미확인",
      "zh": "{label}：未确认"
    },
    {
      "en": "^Superseded by revision (?P<label>.+)$",
      "ko": "개정 {label}(으)로 대체됨",
      "zh": "已被修订 {label} 替代"
    },
    {
      "en": "^revision: (?P<label>.+)$",
      "ko": "개정: {label}",
      "zh": "修订：{label}"
    },
    {
      "en": "^document_number: (?P<label>.+)$",
      "ko": "문서번호: {label}",
      "zh": "文件编号：{label}"
    },
    {
      "en": "^product_name: (?P<label>.+)$",
      "ko": "제품명: {label}",
      "zh": "产品名称：{label}"
    },
    {
      "en": "^Added (?P<label>.+)$",
      "ko": "추가 {label}",
      "zh": "新增 {label}"
    },
    {
      "en": "^Removed (?P<label>.+)$",
      "ko": "삭제 {label}",
      "zh": "删除 {label}"
    }
