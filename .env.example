SPEC_AGENT_DATA_DIR=.runtime
SPEC_AGENT_FONT=
SPEC_AGENT_SESSION_SECONDS=28800
SPEC_AGENT_COOKIE_SECURE=false
# Optional LLM for the revision assistant and customer request analysis.
# Copy this file to .env (git-ignored) and fill in the values. .env is read automatically.
# Check the connection with: uv run spec-agent llm-check
# provider: none (offline rule-based) | openai (OpenAI or any OpenAI-compatible server) | anthropic
SPEC_AGENT_LLM_PROVIDER=none
# e.g. gpt-4o-mini for OpenAI
SPEC_AGENT_LLM_MODEL=
# Leave empty for api.openai.com; e.g. http://localhost:11434/v1 for Ollama
SPEC_AGENT_LLM_BASE_URL=
# Your secret key. Never commit it or paste it into chats.
SPEC_AGENT_LLM_API_KEY=
# true = also send internal standards and customer requests to an external AI service.
# Keep false unless the data is masked and external use is approved.
SPEC_AGENT_LLM_ALLOW_INTERNAL=false
# Report languages generated with every inspection report (en is always the master).
SPEC_AGENT_REPORT_LANGUAGES=en,ko,vi
